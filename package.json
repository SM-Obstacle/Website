{
  "name": "website",
  "version": "1.0.1",
  "private": true,
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build && bun run copy-standalone-assets",
    "copy-standalone-assets": "rm -rf .next/standalone/public .next/standalone/.next/static && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "compile": "graphql-codegen"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "graphql": "^17.1.0",
    "graphql-ws": "^6.4.3",
    "katex": "^0.19.1",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.11.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-math": "^6.0.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
